{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "dist/**"
      ],
      "env": [
        "NODE_ENV",
        "SUPABASE_SERVICE_ROLE_KEY",
        "CLOUDINARY_CLOUD_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "GEOCODING_PROVIDER",
        "GOOGLE_MAPS_API_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",

        "LOCATIONIQ_API_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",

        "MTN_API_BASE_URL",
        "MTN_CONSUMER_KEY",
        "MTN_CONSUMER_SECRET",
        "MTN_CALLBACK_URL",

        "ZEPTOMAIL_API_KEY",
        "ZEPTOMAIL_FROM_EMAIL",
        "ZEPTOMAIL_FROM_NAME"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}